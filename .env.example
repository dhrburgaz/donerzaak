# Copy to .env.local and adjust for your environment.

# "demo" allows placeholder menu/photos/checkout and blocks search indexing.
# "production" enforces validateProductionContent() and requires a real
# OrderProvider — see PRODUCTION_CHECKLIST.md before switching this.
NEXT_PUBLIC_SITE_MODE=demo

# Used for canonical URLs, sitemap.xml, and the OpenGraph image.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
